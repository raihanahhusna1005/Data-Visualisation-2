{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "A vertical bullet chart showing public transport punctuality starting from 50% with an explicit color legend instead of x-axis text labels.",
  "width": 340,
  "height": 280,
  "padding": {
      "top": 20,
      "left": 45
