{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 360,
  "height": 350,
  "padding": {
    "top": 25,
    "left": 45,
    "bottom": 20
  },
  "config": {
    "legend": {
      "orient": "none",
        "legendX": 335,
        "legendY": 90,
      "labelFont": "Times New Roman",
      "labelFontSize": 13,
      "titleFont": "Times New Roman",
      "titleFontSize": 13,
      "titleFontWeight": "bold",
      "titleAnchor": "middle"
    }
  },
  "data": {
    "values": [
      {"Metric": "Pre-AM Peak", "Passengers": 1100},
      {"Metric": "AM Peak", "Passengers": 3600},
      {"Metric": "Interpeak", "Passengers": 12600},
      {"Metric": "PM Peak", "Passengers": 33650},
      {"Metric": "PM Late", "Passengers": 10900}
    ]
  },
  "params": [
    {
      "name": "highlight",
      "select": {"type": "point", "on": "mouseover", "fields": ["Metric"]}
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "arc",
        "innerRadius": 40,
        "stroke": "#fff",
        "strokeWidth": 2,
        "cursor": "pointer"
      },
      "encoding": {
        "theta": {"field": "Passengers", "type": "quantitative", "stack": true},
        "radius": {
          "field": "Passengers",
          "scale": {"type": "sqrt", "zero": true, "rangeMin": 40}
        },
        "color": {
          "field": "Metric",
          "type": "nominal",
          "legend": {"title": "Period"},
          "scale": {
            "range": ["#9c27b0", "#800020", "#ff9800", "#1b5e20", "#e91e63"]
          }
        },
        "opacity": {
          "condition": {"param": "highlight", "value": 1},
          "value": 0.3
        }
      }
    }
  ],
  "encoding": {
    "tooltip": [
      {"field": "Metric", "title": "Period"},
      {"field": "Passengers", "title": "Patronage"}
    ]
  }
}