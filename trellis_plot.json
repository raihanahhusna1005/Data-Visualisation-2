{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "modeoftransportperyear.csv",
    "format": { "type": "csv" }
  },
  "transform": [
    { "filter": "datum.Year != null && datum.Year != '' && datum.Year != 2026" },
    {
      "fold": ["Metropolitan train", "Metropolitan tram", "Metropolitan bus"],
      "as": ["Transport Mode", "RawPatronage"]
    },
    {
      "calculate": "datum.RawPatronage != null ? toNumber(join(split(datum.RawPatronage, ','), '')) : 0",
      "as": "Patronage"
    }
  ],
  "facet": {
    "row": {
      "field": "Transport Mode",
      "title": null,
      "header": { "labels": false }
    }
  },
  "spec": {
    "width": 600,
    "height": 80,
    "layer": [
      {
        "mark": { "type": "area", "interpolate": "monotone", "tooltip": true },
        "encoding": {
          "x": {
            "field": "Year",
            "type": "nominal",
            "axis": { "title": null, "labelAngle": 0, "labelFont": "Times New Roman", "labelFontSize": 13 }
          },
          "y": {
            "aggregate": "sum",
            "field": "Patronage",
            "type": "quantitative",
            "axis": { "title": null, "labels": true, "labelFont": "Times New Roman", "labelFontSize": 13 }
          },
          "color": {
            "field": "Transport Mode",
            "type": "nominal",
            "legend": {
              "title": "Transport Mode:",
              "orient": "none",
              "legendX": 45,
              "legendY": 320,
              "direction": "horizontal",
              "titleOrient": "left",
              "titleAnchor": "middle",
              "labelFont": "Times New Roman",
              "labelFontSize": 13,
              "titleFont": "Times New Roman",
              "titleFontSize": 14,
              "labelPadding": 80, 
              "columnPadding": 30
            },
            "scale": {
              "domain": ["Metropolitan train", "Metropolitan tram", "Metropolitan bus"],
              "range": ["#1b5e20", "#800020", "#ff9800"]
            }
          }
        }
      },
      {
        "name": "Annotation Arrow Down",
        "mark": {
          "type": "text",
          "text": "<<",
          "fontSize": 20,
          "color": "#419aff",
          "angle": 270
        },
        "encoding": {
          "x": { "value": 170 },
          "y": { "value": 30 }
        }
      },
      {
        "name": "Annotation Arrow Up",
        "mark": {
          "type": "text",
          "text": ">>",
          "fontSize": 20,
          "color": "#0f0260",
          "angle": 270
        },
        "encoding": {
          "x": { "value": 290 },
          "y": { "value": 32 }
        }
      }
    ]
  }
}